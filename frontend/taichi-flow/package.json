{
  "name": "taichi-flow-fluent-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:desktop": "node --test desktop/directoryPicker.test.cjs",
    "preview": "vite preview",
    "desktop": "npm run build && electron desktop/main.cjs",
