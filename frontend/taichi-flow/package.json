{
  "name": "taichi-flow-fluent-ui",
  "private": true,
  "version": "0.1.0",
  "productName": "Taichi-Flow",
  "description": "Taichi-Flow local hydrodynamic modelling workbench",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:desktop": "node --test desktop/directoryPicker.test.cjs desktop/runtimePolicy.test.cjs",
    "preview": "vite preview",
    "desktop": "npm run desktop:preview",
    "desktop:dev": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../../scripts/desktop-dev/Start-DesktopDev.ps1 -Mode dev",
    "desktop:preview": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../../scripts/desktop-dev/Start-DesktopDev.ps1 -Mode preview",
    "desktop:smoke": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../../scripts/desktop-dev/Start-DesktopDev.ps1 -Mode dev -Smoke"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.487.0",
    "ol": "10.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "4.12.2",
    "react-router-dom": "^7.13.1",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "43.2.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  }
}
