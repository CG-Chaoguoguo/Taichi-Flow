# Test-only toolchain sandbox and generated intermediates
tests/_fortran_toolchain_sandbox/*

# The sandbox contract keeps only its small, repeatable source skeleton in Git.
!tests/_fortran_toolchain_sandbox/README.md
!tests/_fortran_toolchain_sandbox/.gitignore
!tests/_fortran_toolchain_sandbox/scripts/
!tests/_fortran_toolchain_sandbox/scripts/**
!tests/_fortran_toolchain_sandbox/patches/
tests/_fortran_toolchain_sandbox/patches/*
!tests/_fortran_toolchain_sandbox/patches/instrument_tfail_dump.patch
!tests/_fortran_toolchain_sandbox/fixtures/
!tests/_fortran_toolchain_sandbox/fixtures/README.md
!tests/_fortran_toolchain_sandbox/generated/
tests/_fortran_toolchain_sandbox/generated/*
!tests/_fortran_toolchain_sandbox/generated/.gitkeep
!tests/_fortran_toolchain_sandbox/logs/
tests/_fortran_toolchain_sandbox/logs/*
!tests/_fortran_toolchain_sandbox/logs/.gitkeep
!tests/_fortran_toolchain_sandbox/toolchain/
tests/_fortran_toolchain_sandbox/toolchain/*
!tests/_fortran_toolchain_sandbox/toolchain/.gitkeep
!tests/_fortran_toolchain_sandbox/work/
tests/_fortran_toolchain_sandbox/work/*
!tests/_fortran_toolchain_sandbox/work/.gitkeep

